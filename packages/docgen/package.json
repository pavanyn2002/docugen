{
  "name": "@pavanyn/docugen",
  "version": "1.0.2",
  "description": "Deterministic codebase documentation engine. Extracts what the code proves; never states what it cannot verify.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavanyn2002/docugen.git",
    "directory": "packages/docgen"
  },
  "homepage": "https://github.com/pavanyn2002/docugen#readme",
  "bugs": {
    "url": "https://github.com/pavanyn2002/docugen/issues"
  },
  "private": false,
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "docgen": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/define.d.ts",
      "default": "./dist/config/define.js"
    }
  },
  "files": [
    "dist",
    "prompts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "jiti": "^2.4.2",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.5",
    "tree-sitter": "0.25.1",
    "tree-sitter-python": "0.25.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.12",
    "@types/picomatch": "^3.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^25.0.1",
    "mermaid": "^11.16.1",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "documentation",
    "static-analysis",
    "codegen",
    "mermaid",
    "api-docs",
    "architecture"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
